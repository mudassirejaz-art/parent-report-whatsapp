[Unit]
Description=ParentReport API
After=network-online.target
Wants=network-online.target

[Service]
User=parentreport
WorkingDirectory=/opt/parentreport
EnvironmentFile=/etc/parentreport/runtime.env
ExecStart=/opt/parentreport/backend/.venv/bin/python -m uvicorn app.main:app --app-dir backend --host 127.0.0.1 --port 8000 --no-access-log --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=on-failure
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
