# Local scripts generate backend/.env. Never commit credentials.
DATABASE_URL=postgresql://parentreport_api:REPLACE_LOCALLY@127.0.0.1:55432/parentreport
MIGRATION_DATABASE_URL=postgresql://parentreport_owner:REPLACE_LOCALLY@127.0.0.1:55432/parentreport
APP_ENV=development
# School registration defaults on in development, off in production unless explicitly enabled.
APP_SCHOOL_REGISTRATION=true
# Explicitly opt in for fictional local phone verification only. Never enable in production.
APP_LOCAL_ONBOARDING=false
# Fictional local reset links only; production rejects this flag.
APP_LOCAL_RECOVERY=false
# Optional Meta Cloud API settings. Keep secrets in the ignored backend/.env.
APP_WHATSAPP_WEBHOOK=false
APP_WHATSAPP_LIVE=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEST_RECIPIENT=
WHATSAPP_SCHOOL_ID=
WHATSAPP_OTP_TEMPLATE=
WHATSAPP_REPORT_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=en_US
# ONBOARDING_KEY is generated under ignored backend/.local when local mode is enabled.
APP_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8000

